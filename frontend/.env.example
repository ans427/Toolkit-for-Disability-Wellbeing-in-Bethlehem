VITE_SANITY_PROJECT_ID=bfuuhtl6
VITE_SANITY_DATASET=production
# Optional: only needed for write operations from frontend
# VITE_SANITY_TOKEN=your-sanity-write-token
# Google Maps API key for geocoding (optional, falls back to Nominatim)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Vercel function env vars for Sanity email notifications
# Used by /api/sanity-submission-notify
# SANITY_WEBHOOK_SECRET=choose-a-long-random-string
# Free option (recommended): forward to Google Apps Script webhook
# GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
# Optional recipient/sender metadata passed to Apps Script
# NOTIFY_EMAIL_TO=inclusivebethlehem@gmail.com
# NOTIFY_EMAIL_FROM=Toolkit Notifications <onboarding@resend.dev>
#
# Optional paid fallback: Resend API
# RESEND_API_KEY=re_xxxxxxxxx
# NOTIFY_EMAIL_TO=inclusivebethlehem@gmail.com
# NOTIFY_EMAIL_FROM=Toolkit Notifications <onboarding@resend.dev>
# SANITY_STUDIO_BASE_URL=https://your-sanity-studio-url
